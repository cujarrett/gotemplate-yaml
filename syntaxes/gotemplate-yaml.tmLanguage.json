{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Go Template in YAML",
  "scopeName": "gotemplate.yaml.injection",
  "patterns": [
    {
      "include": "#embedded-yaml"
    },
    {
      "include": "#gotemplate-comment"
    },
    {
      "include": "#gotemplate-expression"
    }
  ],
  "repository": {
    "gotemplate-comment": {
      "begin": "(?:\\{\\{-?|(?<=\\{)\\{-?)\\s*/\\*",
      "end": "\\*/\\s*-?\\}\\}",
      "name": "comment.block.gotemplate"
    },
    "gotemplate-expression": {
      "begin": "\\{\\{-?|(?<=\\{)\\{-?",
      "end": "-?\\}\\}",
      "name": "meta.expression.gotemplate",
      "beginCaptures": {
        "0": {
          "name": "keyword.control.gotemplate"
        }
      },
      "endCaptures": {
        "0": {
          "name": "keyword.control.gotemplate"
        }
      },
      "patterns": [
        {
          "include": "#gotemplate-yaml-escaped-strings"
        },
        {
          "include": "#gotemplate-strings"
        },
        {
          "include": "#gotemplate-raw-strings"
        },
        {
          "include": "#gotemplate-variables"
        },
        {
          "include": "#gotemplate-fields"
        },
        {
          "include": "#gotemplate-keywords"
        },
        {
          "include": "#gotemplate-pipe"
        },
        {
          "include": "#gotemplate-operators"
        },
        {
          "include": "#gotemplate-constants"
        },
        {
          "include": "#gotemplate-builtins"
        },
        {
          "include": "#gotemplate-functions"
        },
        {
          "include": "#gotemplate-numbers"
        }
      ]
    },
    "gotemplate-keywords": {
      "match": "(?<![\\w.$])(if|else|end|range|with|define|template|block|break|continue)\\b",
      "name": "keyword.control.gotemplate"
    },
    "gotemplate-pipe": {
      "match": "\\|",
      "name": "keyword.operator.function.infix.gotemplate"
    },
    "gotemplate-operators": {
      "match": ":=|=",
      "name": "keyword.operator.assignment.gotemplate"
    },
    "gotemplate-constants": {
      "match": "(?<![\\w.$])(nil|true|false)\\b",
      "name": "constant.language.gotemplate"
    },
    "gotemplate-variables": {
      "match": "\\$([A-Za-z_][A-Za-z0-9_]*)?",
      "name": "variable.language.gotemplate"
    },
    "gotemplate-fields": {
      "match": "\\.([A-Za-z_][A-Za-z0-9_]*)?",
      "name": "variable.other.property.gotemplate"
    },
    "gotemplate-builtins": {
      "match": "(?<![\\w.$])(and|call|eq|ge|gt|html|index|js|le|len|lt|ne|not|or|print|printf|println|slice|urlquery)\\b",
      "name": "support.function.builtin.gotemplate"
    },
    "gotemplate-functions": {
      "match": "(?<![\\w.$])[A-Za-z_][A-Za-z0-9_]*",
      "name": "support.function.gotemplate"
    },
    "gotemplate-yaml-escaped-strings": {
      "match": "\\\\\"(?:\\\\\\\\\\\\.|[^\\\\\"])*?\\\\\"",
      "name": "string.quoted.double.gotemplate"
    },
    "gotemplate-strings": {
      "match": "\"(?:[^\"\\\\]|\\\\.)*\"",
      "name": "string.quoted.double.gotemplate"
    },
    "gotemplate-numbers": {
      "match": "(?<![\\w.$])-?[0-9]+(\\.[0-9]+)?\\b",
      "name": "constant.numeric.gotemplate"
    },
    "gotemplate-raw-strings": {
      "match": "`[^`]*`",
      "name": "string.quoted.other.raw.gotemplate"
    },
    "embedded-yaml": {
      "comment": [
        "template: Crossplane go-templating inline template, always YAML.",
        "values: ArgoCD Helm values, always YAML.",
        "The structure mirrors VS Code's own literal block scalar rule, with the content handed to source.yaml.embedded instead of a string."
      ],
      "begin": "(?<=template: |values: )(\\|)([+-]?+)",
      "while": "\\G",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.flow.block-scalar.literal.yaml"
        },
        "2": {
          "name": "storage.modifier.chomping-indicator.yaml"
        }
      },
      "name": "meta.scalar.yaml",
      "patterns": [
        {
          "begin": "$",
          "while": "\\G",
          "patterns": [
            {
              "begin": "\\G(?!$)(?=( *+))",
              "end": "\\G(?!\\1)(?=[\t ]*+#)",
              "patterns": [
                {
                  "begin": "\\G( *+)",
                  "while": "\\G(?>(\\1)|( *+)($|[^\t#]|[\t ]++[^#]))",
                  "captures": {
                    "1": {
                      "name": "punctuation.whitespace.indentation.yaml"
                    },
                    "2": {
                      "name": "punctuation.whitespace.indentation.yaml"
                    }
                  },
                  "contentName": "meta.embedded.block.yaml",
                  "patterns": [
                    {
                      "include": "source.yaml.embedded"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "begin": "\\G",
          "end": "$",
          "patterns": [
            {
              "include": "source.yaml.1.2#presentation-detail"
            }
          ]
        }
      ]
    }
  },
  "injectionSelector": "L:source.yaml string.unquoted.block.yaml, L:source.yaml string.unquoted.plain.out.yaml, L:source.yaml string.unquoted.plain.in.yaml, L:source.yaml string.quoted.double.yaml, L:source.yaml string.quoted.single.yaml, L:source.yaml"
}
